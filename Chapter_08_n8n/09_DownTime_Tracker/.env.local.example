# ---------------------------------------------------------------------------
# VWO QA Downtime Tracker - environment configuration
# Copy to `.env.local` and fill in your values. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# === Server-only (never exposed to the browser) ============================

# Base URL of the n8n instance running the monitoring + API workflows.
# Must be reachable from the machine/Vercel function that runs this app.
N8N_BASE_URL=https://your-n8n.example.com

# Webhook path prefix: "webhook" for production URLs, "webhook-test" while
# testing in the n8n editor (the workflow must be *active* for "webhook").
N8N_WEBHOOK_PATH=webhook

# Optional shared secret. When set it is sent as the `x-api-key` header and the
# n8n Webhook nodes should require it (Header Auth credential).
N8N_API_KEY=

# Outbound request timeout in milliseconds.
# n8n Cloud pauses idle workflows: the first calls after a quiet period can take
# 10-20 s while the instance wakes up, so allow headroom.
N8N_TIMEOUT_MS=30000

# === Optional per-endpoint URL overrides ====================================
# When set, these win over N8N_BASE_URL + N8N_WEBHOOK_PATH for that one
# endpoint — useful when a webhook has a ready-made URL (query string and all).
# Leave them empty to use the standard scheme above.
N8N_INCIDENTS_URL=
N8N_RESOLVE_INCIDENT_URL=

# === Behaviour =============================================================

# "true" reads live data from n8n. Anything else uses the bundled mock dataset.
USE_LIVE_DATA=false

# NOTE: there is no "fall back to mock" switch. Mock data is used only when
# USE_LIVE_DATA is not "true"; once live mode is on, a failing upstream call is
# reported as a warning/degraded section instead of being replaced by sample data.

# How many n8n webhooks /api/dashboard may have in flight at once (default 3).
# Measured median, production build, live instance: 1 -> 6.1 s | 2 -> 3.5 s |
# 3 -> 2.7 s | 5 -> 2.3 s. Higher is faster when your n8n plan tolerates
# parallelism; use 1 if the instance refuses concurrent webhook calls.
DASHBOARD_CONCURRENCY=3

# === Public (inlined into the browser bundle) ===============================

# Base URL of the n8n UI, used only for "Open n8n Execution" deep links.
# Leave empty to disable those buttons.
NEXT_PUBLIC_N8N_UI_URL=https://your-n8n.example.com

# ---------------------------------------------------------------------------
# Aggregated endpoint the dashboard page itself calls (server -> server only):
#   GET  /api/dashboard?environment=Production
#        -> DashboardSnapshot { environment, overallStatus, servicesMonitored,
#             healthyServices, failedServices, activeIncidents,
#             averageResponseTimeMs, uptimePercent, services[], incidents[],
#             responseTimes[], retryHistory[], uptime[], warnings[] }
#   GET  /api/incidents?environment=Production
#   POST /api/incidents/resolve
#
# Endpoints provided by the n8n workflow `09b_DownTime_Tracker_API`:
#   GET  /health-status        -> { summary, services }
#   GET  /health-checks        -> HealthCheck[]
#   GET  /incidents            -> Incident[]         (?id=, ?environment=)
#   GET  /retry-history        -> RetryAttempt[]
#   GET  /response-times       -> ResponseTimeMetric[]
#   GET  /uptime               -> UptimePoint[]
#   GET  /logs                 -> LogEntry[]
#   POST /health-check         -> trigger a run
#   GET  /settings             -> DashboardSettings
#   POST /settings-write       -> persist settings
#   POST /incidents-resolve    -> resolve an incident
#
# All of these are called from the server only (see src/lib/n8n.ts), so no CORS
# configuration is required on the n8n side.
# ---------------------------------------------------------------------------
