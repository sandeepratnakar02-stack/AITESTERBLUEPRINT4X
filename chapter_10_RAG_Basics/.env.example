# ---------------------------------------------------------------------------------------------
# Chapter 10 — PRD RAG Explorer · environment template
#
#   LOCAL      copy to `.env` (gitignored) and add the Groq key. Ollama + ChromaDB are the defaults,
#              so nothing else is needed and local development keeps working unchanged.
#
#   PRODUCTION do NOT upload this file. Enter the values in
#              Vercel → Project → Settings → Environment Variables (full list in DEPLOYMENT.md).
#
# Every value is read **server-side only**. Nothing here reaches the browser, and no VITE_* variable
# is ever used for a secret.
# ---------------------------------------------------------------------------------------------

# === Groq — required in every environment ====================================================
GROQ_API_TOKEN=
# GROQ_API_KEY=                     # accepted alias, if that is the name your environment uses
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_URL=https://api.groq.com/openai/v1
# GROQ_PRICE_IN=0.15                # $ per 1M prompt tokens — verify current Groq rates
# GROQ_PRICE_OUT=0.75               # $ per 1M completion tokens
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1500

# === Embeddings (free providers only) =========================================================
# ollama -> local Ollama server, nomic-embed-text      (default; local development)
# qdrant -> Qdrant Cloud Inference on your free cluster (production: no extra provider or key)
#
# There is deliberately NO paid provider branch: no OPENAI_API_KEY, EMBEDDING_API_KEY or
# EMBEDDING_BASE_URL is used anywhere in this project.
EMBEDDING_PROVIDER=ollama

# --- EMBEDDING_PROVIDER=ollama (local, free) --------------------------------------------------
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768
# EMBED_USE_PREFIXES=true            # nomic-specific search_document:/search_query: prefixes

# --- EMBEDDING_PROVIDER=qdrant (Qdrant Cloud Inference, free tier) ----------------------------
# The SAME cluster embeds the text and stores the vectors, so nothing else is needed.
# Copy the exact model id from: Qdrant Cloud Console -> Cluster detail -> Inference tab,
# and pick one labelled "Cost: Free". Free embedding models are hosted in the US region only.
# QDRANT_EMBED_MODEL=sentence-transformers/all-minilm-l6-v2
# QDRANT_EMBED_DIMS=                # optional; leave unset and the width is read from the cluster

# EMBED_BATCH=32
# EMBED_TIMEOUT=120

# === Vector store ============================================================================
# chroma -> embedded ChromaDB in ./.chroma   (default; local development)
# qdrant -> remote Qdrant cluster            (production: Vercel's filesystem is ephemeral)
VECTOR_STORE=chroma

# --- VECTOR_STORE=qdrant ----------------------------------------------------------------------
# Both embeddings and storage use this one free cluster.
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=
# QDRANT_TIMEOUT=30

# === Document + retrieval tuning =============================================================
# Local development reads the PDF from disk. In production the confidential PDF is deliberately NOT
# deployed — ingest through the UI upload instead (see DEPLOYMENT.md).
# RAG_PDF_PATH=

# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=3
# BM25_K1=1.5
# BM25_B=0.75
# RRF_K=60
# CONTEXT_CHAR_BUDGET=8000

# === Local server ports (ignored by Vercel) ==================================================
# API_PORT=8011
# UI_PORT=5190
